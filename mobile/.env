# Public base URL of the Phibio backend (no trailing slash).
# Expo inlines EXPO_PUBLIC_* variables at bundle time, so restart `expo start`
# after changing this file. Override locally with a git-ignored `.env.local`.
#
#   iOS simulator / Expo Go on the same machine : http://localhost:8080
#   Android emulator (host loopback)             : http://10.0.2.2:8080
#   Physical device on the same Wi-Fi            : http://<your-computer-ip>:8080
#   Production builds (EAS)                      : https://api.phibio.de
EXPO_PUBLIC_API_URL=http://localhost:8080
