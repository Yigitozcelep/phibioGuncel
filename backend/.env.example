# Phibio backend – environment variables (all optional).
# Copy to .env and `set -a; . ./.env; set +a` before starting, or pass them
# to Docker with --env-file.

# Listen port.
PORT=8080

# Where JSON files and uploads are stored (created if missing). Back up this
# directory to back up everything.
DATA_DIR=./data

# Public origin used in absolute image URLs. Leave empty to derive it from
# the request (Host / X-Forwarded-Proto). Set it behind a reverse proxy, e.g.
# BASE_URL=https://api.phibio.de
BASE_URL=

# Initial admin account (used only on the very first start, when users.json
# does not exist). If ADMIN_PASSWORD is empty a random password is generated
# and printed to the log ONCE as "Initial admin password: ...".
ADMIN_USER=admin
ADMIN_PASSWORD=

# Upload size limit in megabytes.
MAX_UPLOAD_MB=20

# Allowed origins for the public API (/api/v1, /uploads). "*" allows all,
# which is what the mobile app needs. Comma-separated list otherwise.
CORS_ORIGINS=*

# Import the phibio.de seed content (TR + EN) on first start. Set to 0 to
# start with an empty site.
SEED=1
